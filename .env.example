# Direct OpenAI access for local development. Server-side only; never use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional local alternative. Vercel deployments use VERCEL_OIDC_TOKEN automatically.
AI_GATEWAY_API_KEY=

# Optional model overrides. Defaults are current as of this release.
OPENAI_RESEARCH_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
