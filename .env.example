# Direct OpenAI access for local development. Server-side only; never use NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional local alternative. Vercel deployments use VERCEL_OIDC_TOKEN automatically.
AI_GATEWAY_API_KEY=

# Optional on a secondary deployment: proxy generation and gallery reads to the canonical deployment.
ATLAS_CACHE_ORIGIN=

# Optional model overrides. The draft model favors latency; deeper supplier work favors coverage.
OPENAI_DRAFT_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.6-luna
OPENAI_SUPPLIER_RESEARCH_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Required for encrypted event collection and the private /analytics dashboard.
# Use a strong password and configure it only as a server-side secret.
ANALYTICS_ADMIN_PASSWORD=

# Admin-only headers (X-Atlas-Force-Refresh, X-Atlas-Deep-Build, ?refresh=1 on the gallery) work only when the request carries X-Atlas-Admin equal to this secret (16+ characters). Unset = those headers are ignored.
ATLAS_ADMIN_SECRET=

# Paid-build limits: 3 per 10 minutes per caller, enrich 1 per atlas per 30 minutes, and a daily cap on new builds (default 60). Stored in the blob store, so they hold across instances.
ATLAS_DAILY_BUILD_LIMIT=60

# Preview and test deployments share the production blob token: give them their own area so they cannot overwrite production atlases (default atlas-foundry/v1).
ATLAS_GALLERY_PREFIX=

# Prices for the per-build cost ledger (USD per 1M tokens, per 1000 web-search calls, per image). Source: OpenAI list prices, https://developers.openai.com/api/docs/pricing, read 2026-10-11.
# The image price is an ESTIMATE (the page gives gpt-image-2.5-flare token rates, $30 per 1M output tokens, and no per-image price): about 6.2k output tokens for a 1536x1024 high-quality image is $0.19.
ATLAS_PRICE_TABLE={"gpt-5.4-mini":{"in":0.75,"cachedIn":0.075,"out":4.5,"search":10},"gpt-5.6-luna":{"in":0.2,"cachedIn":0.02,"out":1.2,"search":10},"gpt-5.6-terra":{"in":2,"cachedIn":0.2,"out":12,"search":10},"gpt-6-astra":{"in":10,"cachedIn":1,"out":50,"search":10},"gpt-image-2.5-flare":{"image":0.19},"tao-1":{"in":0.5,"out":7.5},"chutes/qwen-image-2512":{"image":0.02},"chutes/z-image-turbo":{"image":0.01}}

# Phase B: text research and supplier passes through the TAO-1 API (https://tao1.ai/v1) instead of OpenAI Responses + web_search. Images and image-input calls stay on OpenAI.
ATLAS_TEXT_PROVIDER=
TAO1_API_KEY=
TAO1_BASE_URL=
TAO1_MODEL=

# Images on Chutes (interim, called directly from the atlas server): ATLAS_IMAGE_PROVIDER=chutes needs CHUTES_API_KEY. The per-image prices above for the chutes models are a FLAT ESTIMATE until measured.
# Image QA and hotspot mapping on a TAO-1 vision cell: ATLAS_VISION_PROVIDER=tao1 (needs TAO1_API_KEY).
ATLAS_IMAGE_PROVIDER=
ATLAS_VISION_PROVIDER=
CHUTES_API_KEY=

# New builds per caller per day (default 10), next to 3 per 10 minutes; ATLAS_DAILY_BUILD_LIMIT stays the site-wide daily cap.
ATLAS_CALLER_DAILY_LIMIT=10

# Exploded-view attempts on the live click path (default 1; admin header x-atlas-exploded-attempts 1-3 for prebuild).
ATLAS_EXPLODED_ATTEMPTS=1

# Exploded views on OpenRouter (interim, cheapest model that passes the QA): ATLAS_EXPLODED_PROVIDER=openrouter needs OPENROUTER_API_KEY; attempts 1-2 use ATLAS_EXPLODED_MODEL, attempt 3 ATLAS_EXPLODED_FALLBACK_MODEL.
ATLAS_EXPLODED_PROVIDER=
ATLAS_EXPLODED_MODEL=google/gemini-3.1-flash-lite-image
ATLAS_EXPLODED_FALLBACK_MODEL=google/gemini-3.1-flash-image
OPENROUTER_API_KEY=

# On-demand build jobs for jtao (POST /api/atlas-jobs, GET /api/atlas-jobs/<id>): ATLAS_JOBS_KEY (16+ chars, sent as x-atlas-jobs-key) enables them; ATLAS_JOBS_MAX_CONCURRENT (default 3); ATLAS_JOBS_REFUSE = extra refused words.
ATLAS_JOBS_KEY=
ATLAS_JOBS_MAX_CONCURRENT=
ATLAS_JOBS_REFUSE=
